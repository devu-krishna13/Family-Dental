<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect the root request to the public folder
    RewriteRule ^$ public/ [L]

    # Redirect all other requests to the public folder if they aren't already targeting it
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
